# Copy to .env and fill in the two required values before docker compose up.
# The Compose file rejects a missing URL or model.

# Ollama already running somewhere this container can reach.
# A bridge container cannot use 127.0.0.1 to mean the host.
OLLAMA_BASE_URL=http://192.168.1.100:11434
LOG_AND_ORDER_MODEL=LiquidAI/lfm2.5-2.6b

# Leave empty to disable Bearer authentication. Set it before exposing the port.
LOG_AND_ORDER_API_KEY=

LOG_AND_ORDER_MAX_UPLOAD_MB=32
LOG_AND_ORDER_OLLAMA_TIMEOUT=120
LOG_AND_ORDER_MAX_CONCURRENT_ANALYSES=1

# Port inside the container, and the localhost port published on the host.
LOG_AND_ORDER_PORT=8080
LOG_AND_ORDER_PUBLISH_PORT=8080

# Used by python -m log_and_order.api outside Docker. Compose sets 0.0.0.0
# inside the container and publishes only 127.0.0.1 on the host.
LOG_AND_ORDER_HOST=127.0.0.1
